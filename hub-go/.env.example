# ===== 必填 =====
# AES-256-GCM 加密密钥：base64 编码的 32 字节。生成：openssl rand -base64 32
# 丢失此密钥 = 所有已存凭证/密钥无法解密。
CREDENTIALS_KEY=

# ===== 服务 =====
# SQLite 数据文件路径（容器内默认 /data/tokendash.db，挂载 volume 持久化）
DB_PATH=./data/tokendash.db
LISTEN_ADDR=:8787
# 内置 runner 采集 + 告警扫描 + 推送投递的循环间隔
COLLECT_INTERVAL=15m
# 允许的跨域来源，逗号分隔；留空 = 反射任意 origin（与 Worker 版一致）
CORS_ORIGINS=

# ===== 认证（四路，至少配一路） =====
# 1) Cloudflare Access：team 名与 App AUD。不配则 Access JWT 路关闭（fail-closed 仅当它被请求时）
ACCESS_TEAM=
ACCESS_AUD=
# 1b) runner service token 的 Client ID 白名单（逗号分隔），Access 身份下判定 runner 角色
RUNNER_SERVICE_TOKENS=

# 2) Logto OIDC：endpoint 形如 https://<tenant>.logto.app/oidc，audience 为 API resource indicator
LOGTO_ENDPOINT=
LOGTO_AUDIENCE=

# 3) 本地/自托管 Bearer token（仅建议内网）。可后缀 :runner / :client 获得对应角色
DEV_TOKEN=

# ===== Web Push（可选） =====
# VAPID 密钥对（base64url，65 字节 uncompressed P-256 公钥）；subject 形如 mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ===== APNs iOS 推送（可选） =====
# .p8 私钥全文（PEM，含 BEGIN/END 行）
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_USE_SANDBOX=0
