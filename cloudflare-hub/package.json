{
  "name": "cloudflare-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx wrangler dev --config ../wrangler.jsonc",
    "deploy": "npx wrangler deploy --config ../wrangler.jsonc",
    "db:migrate:local": "npx wrangler d1 migrations apply DB --local --config ../wrangler.jsonc",
    "db:migrate:remote": "npx wrangler d1 migrations apply DB --remote --config ../wrangler.jsonc",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "rotate-key": "node scripts/rotate-key.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250701.0",
    "esbuild": "^0.25.0",
    "miniflare": "^4.20250701.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
