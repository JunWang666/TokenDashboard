# Cloudflare Deploy to Cloudflare / Workers Builds reads this file as the
# list of values that can be supplied during deployment.

# Required: 32 random bytes encoded as base64.
CREDENTIALS_KEY=

# Set both after creating a Cloudflare Access application for the Worker.
# Leaving them empty keeps the API fail-closed until Access is configured.
ACCESS_TEAM=
ACCESS_AUD=

# Optional. Leave empty for same-origin deployment or add comma-separated URLs
# when a separately hosted client needs to call the API.
CORS_ORIGINS=

# Optional. These are service-token client IDs, not service-token secrets.
RUNNER_SERVICE_TOKENS=tokendash-runner
